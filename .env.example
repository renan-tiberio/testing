# Copy to .env.local, or run `vercel env pull .env.local` in a linked project.
# Only NEXT_PUBLIC_* values reach the browser; never prefix a secret with it.

# Supabase project URL and publishable key (public by design, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Postgres connection strings (server-only secrets)
POSTGRES_URL=postgres://user:password@host:6543/postgres
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/postgres
